# ============================================================================
# Gruvle Reach — environment configuration
# Copy to .env and fill in. Every value below is OPTIONAL except where marked
# REQUIRED — the app must start and the core loop must work with only the
# REQUIRED values set (Ollama running locally, a Postgres database).
# ============================================================================

# ---- Core (REQUIRED) --------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
# Fernet key for encrypting stored integration credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Postgres connection string (SQLAlchemy psycopg3 driver form)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gruvle_reach
# Optional: separate direct (non-pooled) connection for Alembic migrations if
# your provider uses a transaction-pooled connection (e.g. Supabase pgbouncer)
# that doesn't support DDL well. Falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=

# Redis (queue + cache). Core app degrades to synchronous execution if unset.
REDIS_URL=redis://localhost:6379/0

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ---- AI provider (Ollama is the default, free, local option) ---------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional: Groq (free tier available) — set AI_PROVIDER=groq to use it
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: any OpenAI-compatible endpoint — set AI_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ---- Search provider ---------------------------------------------------------
# SEARCH_PROVIDER=searxng | tavily | rss | manual
# searxng: self-hosted, free, no API key — but many public search engines
#   now block/CAPTCHA cloud-hosting IPs, which can leave it returning zero
#   results in a hosted deployment (see CLAUDE.md).
# tavily: a real authenticated search API built for AI agents — doesn't hit
#   that blocking. Free tier available at tavily.com; set TAVILY_API_KEY.
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8888
TAVILY_API_KEY=

# ---- Email provider ----------------------------------------------------------
# EMAIL_PROVIDER=resend | smtp | disabled
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gruvle Reach <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---- Social integrations (all optional; app runs fully without these) ------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# ---- Notifications -----------------------------------------------------------
SLACK_WEBHOOK_URL=
